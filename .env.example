# Copie para .env e preencha o que precisar. O arquivo .env não vai para o git.

# Chaves de API do servidor (opcionais: cada usuário pode informar a própria na interface)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Pasta que o agente pode acessar
NEUROCORE_WORKSPACE=

# Exige este token para usar a API (recomendado em servidores públicos)
NEUROCORE_ACCESS_TOKEN=

# Modo público: desativa comandos de shell e escrita de arquivos (ligado automaticamente no Render)
# NEUROCORE_PUBLIC_MODE=true
# NEUROCORE_ENABLE_DANGEROUS_TOOLS=false

# Origens externas permitidas no CORS (separadas por vírgula)
# NEUROCORE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Mensagens por minuto por IP (0 desliga)
# NEUROCORE_RATE_LIMIT_PER_MINUTE=30

# Provedor padrão: local | gemini | openai | anthropic | openrouter
# NEUROCORE_DEFAULT_PROVIDER=local

# Anexos e imagens
# NEUROCORE_MAX_UPLOAD_BYTES=15728640
# NEUROCORE_MAX_ATTACHMENTS_PER_MESSAGE=10
# NEUROCORE_ENABLE_IMAGE_GENERATION=true
# NEUROCORE_OPENAI_IMAGE_MODEL=gpt-image-1
# NEUROCORE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# NEUROCORE_OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Fuso horário padrão do prompt
# NEUROCORE_TIMEZONE=America/Sao_Paulo
